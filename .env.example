# Luthor Lab settings. Copy to .env and fill in only what you use.
# SCANNER, ANALYST and TESTER need nothing here.

# ---- ORACLE (Telegram bot), optional ----
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your own chat id (a number). The bot answers this chat only. See SETUP.md step 7.
TELEGRAM_CHAT_ID=
# Scheduled scan summary, minutes (0 = off)
ORACLE_SCAN_EVERY_MIN=240

# ---- Danger zone: read README "Safety" before changing ----
# 1 = free-text messages from your chat are sent to Claude Code on this machine
ORACLE_ALLOW_CLAUDE=0
# readonly = Claude can only read repo files; full = Claude can run ANY command on this machine
ORACLE_CLAUDE_MODE=readonly

# ---- Optional ----
# LAB_DATA_DIR=./data
# LAB_SCAN_BUDGET_S=75
# LAB_USER_AGENT=
# CLAUDE_BIN=
# LAB_CLAUDE_MODEL=
# ORACLE_CLAUDE_TIMEOUT_S=1800
